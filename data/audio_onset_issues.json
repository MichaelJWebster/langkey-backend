      "key": "audio/nb/82f2aa5b11e246d41b5d.wav",
      "onset_strength": 0.195
    },
    {
      "text": "Det står en mann ved døra.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/340a50b64af0e3f0b9f9.wav",
      "onset_strength": 0.233
    },
    {
      "text": "Svaret ditt er riktig.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/dcf11ba45a517039a4b2.wav",
      "onset_strength": 0.271
    },
    {
      "text": "En kaffe og en bolle, takk.",
      "voice": "nvcc:7",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/8f8c965730c37cd70079.wav",
      "onset_strength": 0.276
    },
    {
      "text": "Toget går om fem minutter.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/92a7068f96f8fd6b0c96.wav",
      "onset_strength": 0.305
    },
    {
      "text": "Om sommeren bader vi på stranda.",
      "voice": "nvcc:7",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/c764b6d51736660d2bfd.wav",
      "onset_strength": 0.307
    },
    {
      "text": "Unnskyld, hva heter du igjen?",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/118f599f6bd132d21b8d.wav",
      "onset_strength": 0.315
    },
    {
      "text": "Om vinteren går vi på ski i marka.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/35882ffd8a85a0c37d19.wav",
      "onset_strength": 0.34
    },
    {
      "text": "Vi drar på hytta i påsken.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/e42db6ed9e56017909fd.wav",
      "onset_strength": 0.343
    },
    {
      "text": "Om sommeren sykler jeg overalt.",
      "voice": "nvcc:5",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/eb9c4e4730b24febe12a.wav",
      "onset_strength": 0.348
    },
    {
      "text": "Vi går tur i parken.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/723dd3e176a3007f01fa.wav",
      "onset_strength": 0.382
    },
    {
      "text": "Jeg skriver en e-post.",
      "voice": "nvcc:1",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/852798ae93ae966f99ba.wav",
      "onset_strength": 0.407
    },
    {
      "text": "Jeg kommer fra en liten by.",
      "voice": "nvcc:7",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/e1b377eeafa4864797bb.wav",
      "onset_strength": 0.409
    },
    {
      "text": "Vi spiser lunsj sammen på jobben.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/13f65622010dfc5b713a.wav",
      "onset_strength": 0.412
    },
    {
      "text": "Jeg snakker litt norsk.",
