      "key": "audio/nb/a6e355058b1008c8c887.wav",
      "onset_strength": 0.195
    },
    {
      "text": "Det står en mann ved døra.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/ac3e1f0debc60d9ebc77.wav",
      "onset_strength": 0.233
    },
    {
      "text": "Svaret ditt er riktig.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/e561a57f9e700811a4f3.wav",
      "onset_strength": 0.271
    },
    {
      "text": "En kaffe og en bolle, takk.",
      "voice": "nvcc:7",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/4d8dad9bc558f0d31e40.wav",
      "onset_strength": 0.276
    },
    {
      "text": "Toget går om fem minutter.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/42b3d54ce828fd16b538.wav",
      "onset_strength": 0.305
    },
    {
      "text": "Om sommeren bader vi på stranda.",
      "voice": "nvcc:7",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/a2d6ad52316162debfd6.wav",
      "onset_strength": 0.307
    },
    {
      "text": "Unnskyld, hva heter du igjen?",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/c41b81f7e78b0691bb91.wav",
      "onset_strength": 0.315
    },
    {
      "text": "Om vinteren går vi på ski i marka.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/c84da5679d748ba0f97b.wav",
      "onset_strength": 0.34
    },
    {
      "text": "Vi drar på hytta i påsken.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/5a973bf4b78ef5dc4a7e.wav",
      "onset_strength": 0.343
    },
    {
      "text": "Om sommeren sykler jeg overalt.",
      "voice": "nvcc:5",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/191de74ba55188d47473.wav",
      "onset_strength": 0.348
    },
    {
      "text": "Vi går tur i parken.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/fe1a8cde8da21cd6c38a.wav",
      "onset_strength": 0.382
    },
    {
      "text": "Jeg skriver en e-post.",
      "voice": "nvcc:1",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/03bc2bb737124de32de7.wav",
      "onset_strength": 0.407
    },
    {
      "text": "Jeg kommer fra en liten by.",
      "voice": "nvcc:7",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/dca3565b2e593f4f1935.wav",
      "onset_strength": 0.409
    },
    {
      "text": "Vi spiser lunsj sammen på jobben.",
      "voice": "nvcc:4",
      "primary": false,
      "scale": 1.6,
      "key": "audio/nb/4f8fe3d2df510cd4e44d.wav",
      "onset_strength": 0.412
    },
    {
      "text": "Jeg snakker litt norsk.",
